# Copie este arquivo para terraform.tfvars e preencha com seus valores
# terraform.tfvars está no .gitignore e não será versionado

# Nome do bucket S3 (deve ser globalmente único - inclua seu grupo/ID)
bucket_name = "mercadofacil-bigdata-grupo-XX"

# ARN da LabRole do AWS Academy
# Obtenha executando: aws iam get-role --role-name LabRole --query Role.Arn --output text
lab_role_arn = "arn:aws:iam::ACCOUNT_ID:role/LabRole"

# Nome do projeto (opcional, já tem default)
# project_name = "mercadofacil-bigdata"
