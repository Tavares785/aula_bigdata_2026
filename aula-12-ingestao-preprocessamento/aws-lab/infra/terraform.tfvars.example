# Copie este arquivo para terraform.tfvars e preencha com os valores reais.
# NUNCA versione o terraform.tfvars (já está no .gitignore).

# Nome do bucket: deve ser único globalmente — inclua o identificador do grupo.
# Exemplo: "bigdata-mercadofacil-grupo42"
bucket_name = "bigdata-mercadofacil-grupox"

# ARN da LabRole do AWS Academy Learner Lab.
# Para obter: aws iam get-role --role-name LabRole --query Role.Arn --output text
lab_role_arn = "arn:aws:iam::123456789012:role/LabRole"
