#!/bin/bash
# Roda uma vez, como root, no primeiro boot da EC2. Log: /var/log/superset-setup.log
exec > /var/log/superset-setup.log 2>&1
set -x

dnf install -y docker
systemctl enable --now docker

mkdir -p /opt/superset
cd /opt/superset

cat > Dockerfile <<'EOF'
FROM apache/superset:3.1.3
USER root
RUN pip install --no-cache-dir "pyathena[sqlalchemy]==3.8.3"
USER superset
EOF

cat > superset_config.py <<'EOF'
SECRET_KEY = "${secret_key}"
FEATURE_FLAGS = {"ENABLE_TEMPLATE_PROCESSING": True}
EOF

docker build -t superset-athena .

docker run -d --name superset --restart unless-stopped -p 8088:8088 \
  -v /opt/superset/superset_config.py:/app/pythonpath/superset_config.py \
  -v superset_home:/app/superset_home \
  -e AWS_DEFAULT_REGION=${regiao} \
  superset-athena

# espera o container aceitar comandos
for i in $(seq 1 30); do docker exec superset superset version && break; sleep 5; done

docker exec superset superset db upgrade
docker exec superset superset fab create-admin \
  --username admin --firstname Aluno --lastname Aula14 \
  --email admin@example.com --password '${senha}'
docker exec superset superset init

# Conexao com o Athena ja cadastrada (credenciais vem da LabRole via metadados da EC2)
docker exec superset superset set-database-uri \
  --database_name "Athena - MercadoFacil" \
  --uri "awsathena+rest://:@athena.${regiao}.amazonaws.com:443/${database}?s3_staging_dir=${result_s3url}&work_group=${workgroup}"

echo "SUPERSET PRONTO"
